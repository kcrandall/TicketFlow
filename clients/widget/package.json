{
  "name": "@ticketflow/livechat-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-light TicketFlow live-chat web widget (SignalR visitor hub, shadow DOM UI).",
  "license": "MIT",
  "type": "module",
  "main": "dist/ticketflow-chat.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --global-name=TicketFlowChat --target=es2022 --minify --sourcemap --sources-content=false --outfile=dist/ticketflow-chat.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
