<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>IdentityFlow adapter for TicketFlow: maps IdentityFlow browser sessions, bearer tokens, personal access tokens and API keys to TicketFlow principals (with team snapshots) for endpoints and SignalR hubs, and validates IdentityFlow-issued JWTs for live-chat visitor identity.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="IdentityFlow.Hosting.AspNetCore.Authentication" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Hosting/TicketFlow.Hosting.AspNetCore/TicketFlow.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="../../Hosting/TicketFlow.Realtime.SignalR/TicketFlow.Realtime.SignalR.csproj" />
    <ProjectReference Include="../../Workspaces/TicketFlow.Workspaces.Abstractions/TicketFlow.Workspaces.Abstractions.csproj" />
    <ProjectReference Include="../../Channels/TicketFlow.Channels.LiveChat/TicketFlow.Channels.LiveChat.csproj" />
  </ItemGroup>
</Project>
