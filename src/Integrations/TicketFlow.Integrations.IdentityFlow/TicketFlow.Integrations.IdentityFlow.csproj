<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>IdentityFlow adapter for TicketFlow endpoints: maps IdentityFlow browser sessions, bearer tokens, personal access tokens and API keys to TicketFlow principals (staff identity links or prefixed identifiers, team snapshots). SignalR and live-chat visitor tokens live in TicketFlow.Integrations.IdentityFlow.SignalR.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="IdentityFlow.Hosting.AspNetCore.Authentication" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Access/TicketFlow.Access/TicketFlow.Access.csproj" />
    <ProjectReference Include="../../Hosting/TicketFlow.Hosting.AspNetCore/TicketFlow.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="../../Workspaces/TicketFlow.Workspaces.Abstractions/TicketFlow.Workspaces.Abstractions.csproj" />
    <ProjectReference Include="../../Identity/TicketFlow.Identity.Abstractions/TicketFlow.Identity.Abstractions.csproj" />
  </ItemGroup>
</Project>
