@* Renders a form outcome (success, forbidden, conflict, validation) as a shadcn alert. *@
<div class="@CssClass" role="@(Outcome.Succeeded ? "status" : "alert")" data-outcome="@KindToken">
    <LucideIcon Name="@Icon" Size="16" Class="tf-alert__icon" />
    <div class="tf-alert__body">
        <div class="tf-alert__title">@Outcome.Title</div>
        @if (Outcome.Messages.Count > 0)
        {
            <ul class="tf-alert__messages">
                @foreach (var message in Outcome.Messages)
                {
                    <li>@message</li>
                }
            </ul>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public UiOutcome Outcome { get; set; } = default!;

    private string CssClass => Outcome.Kind switch
    {
        UiOutcomeKind.Success => "tf-alert tf-alert--success",
        UiOutcomeKind.Info => "tf-alert tf-alert--info",
        UiOutcomeKind.Conflict or UiOutcomeKind.Rejected => "tf-alert tf-alert--warning",
        _ => "tf-alert tf-alert--destructive",
    };

    private string KindToken => Outcome.Kind switch
    {
        UiOutcomeKind.Success => "success",
        UiOutcomeKind.Info => "info",
        UiOutcomeKind.Forbidden => "forbidden",
        UiOutcomeKind.NotFound => "notfound",
        UiOutcomeKind.Conflict => "conflict",
        UiOutcomeKind.Invalid => "invalid",
        UiOutcomeKind.Rejected => "rejected",
        _ => "error",
    };

    private string Icon => Outcome.Kind switch
    {
        UiOutcomeKind.Success => "circle-check",
        UiOutcomeKind.Info => "info",
        UiOutcomeKind.Forbidden => "shield-x",
        UiOutcomeKind.Conflict => "git-compare-arrows",
        UiOutcomeKind.NotFound => "search-x",
        _ => "circle-alert",
    };
}
