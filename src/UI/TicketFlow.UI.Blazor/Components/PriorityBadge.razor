@using TicketFlow.Conversations
@if (Priority != ConversationPriority.None || ShowNone)
{
    <span class="@CssClass" title="Priority">
        <LucideIcon Name="@Icon" Size="12" />@Label
    </span>
}

@code {
    [Parameter] public ConversationPriority Priority { get; set; }
    [Parameter] public bool ShowNone { get; set; }

    private string CssClass => Priority switch
    {
        ConversationPriority.Urgent => "tf-priority tf-priority--urgent",
        ConversationPriority.High => "tf-priority tf-priority--high",
        ConversationPriority.Medium => "tf-priority tf-priority--medium",
        ConversationPriority.Low => "tf-priority tf-priority--low",
        _ => "tf-priority tf-priority--none",
    };

    private string Label => Priority switch
    {
        ConversationPriority.Urgent => "Urgent",
        ConversationPriority.High => "High",
        ConversationPriority.Medium => "Medium",
        ConversationPriority.Low => "Low",
        _ => "No priority",
    };

    private string Icon => Priority switch
    {
        ConversationPriority.Urgent => "triangle-alert",
        ConversationPriority.High => "signal-high",
        ConversationPriority.Medium => "signal-medium",
        ConversationPriority.Low => "signal-low",
        _ => "minus",
    };
}
