@inherits UiPageBase
@using TicketFlow.Workspaces

<PageHeader Title="Access" Description="Manage non-human service accounts, bind them to ACL roles, and issue revocable API keys." />
<AccessTabs Active="service-accounts" />

<AccessGate Denied="Denied">
    @if (!Session.Options.ManageApiKeysInUI)
    {
        <div class="tf-card">
            <div class="tf-card__content">
                <EmptyState Icon="bot"
                            Title="Service accounts managed externally"
                            Message="Service accounts and API keys are managed by your external identity provider. Assign TicketFlow roles to external client_id subjects on the Grants tab or map external roles on the Role Federation tab.">
                    <div class="tf-row" style="margin-top:8px">
                        <a class="tf-button tf-button--outline tf-button--sm" href="@Url("access/grants")">
                            <LucideIcon Name="key-round" Size="14" />Open Grants
                        </a>
                        @if (Session.Has<IRoleFederationService>())
                        {
                            <a class="tf-button tf-button--outline tf-button--sm" href="@Url("access/federation")">
                                <LucideIcon Name="globe" Size="14" />Open Role Federation
                            </a>
                        }
                    </div>
                </EmptyState>
            </div>
        </div>
    }
    else
    {
        @if (Session.PageState is IssuedApiKey issued)
        {
            <div class="tf-card" data-issued-api-key style="border-color:var(--primary)">
                <div class="tf-card__header">
                    <div class="tf-row" style="gap:8px">
                        <LucideIcon Name="key-round" Size="16" />
                        <div>
                            <div class="tf-card__title">API key issued · @issued.Key.Name</div>
                            <div class="tf-card__description">
                                Service account <span class="tf-mono">@issued.Key.ClientId.Value</span>
                                @if (issued.Key.ExpiresAtUtc is { } expiresAt)
                                {
                                    <span> · Expires @expiresAt.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)</span>
                                }
                                else
                                {
                                    <span> · No expiry</span>
                                }
                            </div>
                        </div>
                    </div>
                    <span class="tf-badge tf-badge--warning"><LucideIcon Name="triangle-alert" Size="12" />Shown once</span>
                </div>
                <div class="tf-card__content tf-stack tf-stack--sm">
                    <div class="tf-row tf-row--between" style="gap:12px;padding:10px 12px;border:1px solid var(--border);border-radius:var(--radius);background:var(--muted)">
                        <code id="tf-issued-api-key-code" class="tf-code" data-issued-api-key-value style="word-break:break-all;font-size:13px">@issued.PlaintextKey</code>
                        <button type="button"
                                class="tf-button tf-button--outline tf-button--xs"
                                data-copy-target="#tf-issued-api-key-code"
                                data-copy-feedback="Copied!">
                            <LucideIcon Name="copy" Size="12" />
                            <span>Copy key</span>
                        </button>
                    </div>
                    <div class="tf-small">
                        <strong>Copy this key now — it will never be displayed again.</strong>
                    </div>
                    <div class="tf-small tf-muted">
                        Authenticate requests with <span class="tf-code">X-Api-Key: &lt;key&gt;</span> or <span class="tf-code">Authorization: Bearer &lt;key&gt;</span>.
                    </div>
                </div>
            </div>
        }

        @if (serviceAccounts.Count == 0)
        {
            <div class="tf-card">
                <div class="tf-card__content">
                    <EmptyState Icon="bot"
                                Title="No service accounts yet"
                                Message="Create a service account below to bind non-human automation to ACL roles and issue revocable API keys." />
                </div>
            </div>
        }

        @foreach (var sa in serviceAccounts)
        {
            var clientId = sa.Account.ClientId.Value;
            var saGrants = grantsByClient.GetValueOrDefault(clientId) ?? [];
            var saKeys = keysByClient.GetValueOrDefault(clientId) ?? [];
            var defaultScopeValue = ScopeOptionValue(sa.Account.Scope);

            <div class="tf-card" data-service-account="@clientId">
                <div class="tf-card__header">
                    <div class="tf-stack tf-stack--sm" style="gap:4px">
                        <div class="tf-row" style="gap:8px">
                            <LucideIcon Name="bot" Size="15" />
                            <div class="tf-card__title">@sa.Account.DisplayName</div>
                            <span class="tf-code tf-mono">@clientId</span>
                            @if (sa.IsEnabled)
                            {
                                <span class="tf-badge tf-badge--success">Active</span>
                            }
                            else
                            {
                                <span class="tf-badge tf-badge--warning">Disabled</span>
                            }
                            <BbBadge Variant="BadgeVariant.Outline">@ScopeLabel(sa.Account.Scope)</BbBadge>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(sa.Account.Description))
                        {
                            <div class="tf-card__description">@sa.Account.Description</div>
                        }
                        @if (!sa.IsEnabled && !string.IsNullOrWhiteSpace(sa.DisabledReason))
                        {
                            <div class="tf-small tf-muted">Disabled reason: @sa.DisabledReason</div>
                        }
                    </div>
                    <div class="tf-row" style="gap:6px">
                        <TfForm Action="@(sa.IsEnabled ? "access.serviceaccount.disable" : "access.serviceaccount.enable")"
                                Revision="sa.Version"
                                Class="tf-inline-form">
                            <input type="hidden" name="clientId" value="@clientId" />
                            <button type="submit" class="tf-button tf-button--outline tf-button--xs">
                                @(sa.IsEnabled ? "Disable" : "Enable")
                            </button>
                        </TfForm>
                        <TfForm Action="access.serviceaccount.delete"
                                Revision="sa.Version"
                                Class="tf-inline-form">
                            <input type="hidden" name="clientId" value="@clientId" />
                            <button type="submit" class="tf-button tf-button--ghost tf-button--xs" style="color:var(--destructive)">
                                Delete
                            </button>
                        </TfForm>
                    </div>
                </div>

                <div class="tf-card__content tf-stack">
                    <details>
                        <summary class="tf-small tf-muted" style="cursor:pointer">Edit name &amp; description</summary>
                        <div style="margin-top:10px">
                            <TfForm Action="access.serviceaccount.update" Revision="sa.Version" Class="tf-form">
                                <input type="hidden" name="clientId" value="@clientId" />
                                <div class="tf-form-grid">
                                    <div class="tf-field">
                                        <label class="tf-label">Display name</label>
                                        <input name="name"
                                               class="tf-input"
                                               required
                                               maxlength="256"
                                               value="@sa.Account.DisplayName" />
                                    </div>
                                    <div class="tf-field">
                                        <label class="tf-label">Description</label>
                                        <input name="description"
                                               class="tf-input"
                                               maxlength="1024"
                                               placeholder="Optional description"
                                               value="@sa.Account.Description" />
                                    </div>
                                </div>
                                <div class="tf-row">
                                    <button type="submit" class="tf-button tf-button--outline tf-button--xs">Save details</button>
                                </div>
                            </TfForm>
                        </div>
                    </details>

                    <div class="tf-stack tf-stack--sm">
                        <div class="tf-section-title">Assigned ACL grants (@saGrants.Count)</div>
                        @if (saGrants.Count > 0)
                        {
                            <div class="tf-table-wrap">
                                <table class="tf-table">
                                    <thead>
                                        <tr>
                                            <th>Role</th>
                                            <th>Effect</th>
                                            <th>Scope</th>
                                            <th>Justification</th>
                                            <th class="tf-num"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var storedGrant in saGrants)
                                        {
                                            var grant = storedGrant.Grant;
                                            <tr>
                                                <td class="tf-nowrap">
                                                    <span class="tf-badge">@RoleLabel(grant.Role)</span>
                                                </td>
                                                <td class="tf-nowrap">
                                                    @if (grant.Effect == GrantEffect.Allow)
                                                    {
                                                        <span class="tf-badge tf-badge--success">Allow</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="tf-badge tf-badge--destructive">Deny</span>
                                                    }
                                                </td>
                                                <td class="tf-nowrap">@ScopeLabel(grant.Scope)</td>
                                                <td class="tf-small tf-muted" style="max-width:260px">
                                                    @(string.IsNullOrWhiteSpace(grant.Justification) ? "—" : grant.Justification)
                                                </td>
                                                <td class="tf-num tf-nowrap">
                                                    <TfForm Action="access.grant.revoke"
                                                            Revision="storedGrant.Revision"
                                                            Class="tf-inline-form">
                                                        <input type="hidden" name="id" value="@grant.Id.Value" />
                                                        <button type="submit" class="tf-button tf-button--ghost tf-button--xs" style="color:var(--destructive)">Revoke</button>
                                                    </TfForm>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="tf-small tf-muted">No active ACL grants. Service accounts have no permissions until a role is granted.</div>
                        }

                        @if (roleNames.Count > 0)
                        {
                            <TfForm Action="access.serviceaccount.grant" Class="tf-row" style="gap:8px;align-items:flex-end">
                                <input type="hidden" name="clientId" value="@clientId" />
                                <div class="tf-field" style="min-width:150px">
                                    <label class="tf-label">Role</label>
                                    <select name="role" class="tf-select tf-select--sm">
                                        @foreach (var entry in roleNames)
                                        {
                                            <option value="@entry.Key">@entry.Value</option>
                                        }
                                    </select>
                                </div>
                                <div class="tf-field" style="min-width:170px">
                                    <label class="tf-label">Scope</label>
                                    <select name="scope" class="tf-select tf-select--sm">
                                        @if (CanManageTenant)
                                        {
                                            <option value="tenant" selected="@(defaultScopeValue == "tenant")">Tenant</option>
                                        }
                                        <option value="workspace" selected="@(defaultScopeValue == "workspace")">Whole workspace</option>
                                        @foreach (var team in Teams)
                                        {
                                            var optionValue = $"team:{team.Id.Value}";
                                            <option value="@optionValue" selected="@(defaultScopeValue == optionValue)">Team · @team.Name</option>
                                        }
                                        @foreach (var inbox in Inboxes)
                                        {
                                            var optionValue = $"inbox:{inbox.Inbox.Id.Value}";
                                            <option value="@optionValue" selected="@(defaultScopeValue == optionValue)">Inbox · @inbox.Inbox.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="tf-field" style="min-width:110px">
                                    <label class="tf-label">Effect</label>
                                    <select name="effect" class="tf-select tf-select--sm">
                                        <option value="Allow" selected>Allow</option>
                                        <option value="Deny">Deny</option>
                                    </select>
                                </div>
                                <div class="tf-field" style="flex:1;min-width:160px">
                                    <label class="tf-label">Justification</label>
                                    <input name="justification"
                                           class="tf-input tf-input--sm"
                                           maxlength="1024"
                                           placeholder="Optional reason" />
                                </div>
                                <button type="submit" class="tf-button tf-button--outline tf-button--sm">
                                    <LucideIcon Name="shield" Size="13" />Grant role
                                </button>
                            </TfForm>
                        }
                    </div>

                    <div class="tf-stack tf-stack--sm">
                        <div class="tf-section-title">API keys (@saKeys.Count)</div>
                        @if (saKeys.Count > 0)
                        {
                            <div class="tf-table-wrap">
                                <table class="tf-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Key prefix</th>
                                            <th>Status</th>
                                            <th>Created</th>
                                            <th>Expires</th>
                                            <th>Last used</th>
                                            <th class="tf-num"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var key in saKeys)
                                        {
                                            var isActive = key.IsActiveAt(currentTime);
                                            var isExpired = !key.IsRevoked && key.IsExpiredAt(currentTime);
                                            <tr>
                                                <td>@key.Name</td>
                                                <td class="tf-nowrap">
                                                    <span class="tf-code tf-mono">@(key.KeyPrefix)…</span>
                                                </td>
                                                <td class="tf-nowrap">
                                                    @if (key.IsRevoked)
                                                    {
                                                        <span class="tf-badge tf-badge--destructive">Revoked</span>
                                                    }
                                                    else if (isExpired)
                                                    {
                                                        <span class="tf-badge tf-badge--warning">Expired</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="tf-badge tf-badge--success">Active</span>
                                                    }
                                                </td>
                                                <td class="tf-small tf-muted tf-nowrap">
                                                    @key.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)
                                                </td>
                                                <td class="tf-small tf-muted tf-nowrap">
                                                    @(key.ExpiresAtUtc is { } exp
                                                        ? exp.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)
                                                        : "No expiry")
                                                </td>
                                                <td class="tf-small tf-muted tf-nowrap">
                                                    @(key.LastUsedAtUtc is { } lastUsed
                                                        ? lastUsed.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)
                                                        : "Never")
                                                </td>
                                                <td class="tf-num tf-nowrap">
                                                    @if (isActive)
                                                    {
                                                        <TfForm Action="access.serviceaccount.key.revoke"
                                                                Revision="key.Version"
                                                                Class="tf-inline-form">
                                                            <input type="hidden" name="keyId" value="@key.Id.Value" />
                                                            <button type="submit" class="tf-button tf-button--ghost tf-button--xs" style="color:var(--destructive)">Revoke</button>
                                                        </TfForm>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="tf-small tf-muted">No API keys issued yet.</div>
                        }

                        @if (sa.IsEnabled)
                        {
                            <TfForm Action="access.serviceaccount.key.create" Class="tf-row" style="gap:8px;align-items:flex-end">
                                <input type="hidden" name="clientId" value="@clientId" />
                                <div class="tf-field" style="flex:1;min-width:180px">
                                    <label class="tf-label">Key name</label>
                                    <input name="name"
                                           class="tf-input tf-input--sm"
                                           required
                                           maxlength="256"
                                           placeholder="e.g. prod-sync-2026" />
                                </div>
                                <div class="tf-field" style="min-width:150px">
                                    <label class="tf-label">Expiry</label>
                                    <select name="expiresDays" class="tf-select tf-select--sm">
                                        <option value="">No expiry</option>
                                        <option value="30">30 days</option>
                                        <option value="90" selected>90 days</option>
                                        <option value="365">365 days</option>
                                    </select>
                                </div>
                                <button type="submit" class="tf-button tf-button--secondary tf-button--sm">
                                    <LucideIcon Name="key-round" Size="13" />Issue API key
                                </button>
                            </TfForm>
                        }
                        else
                        {
                            <div class="tf-small tf-muted">Enable this service account to issue new API keys.</div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="tf-card">
            <div class="tf-card__header">
                <div>
                    <div class="tf-card__title">New service account</div>
                    <div class="tf-card__description">Create a non-human identity for CI jobs, ticket sync workers, or backend integrations, then issue revocable API keys.</div>
                </div>
            </div>
            <div class="tf-card__content">
                <TfForm Action="access.serviceaccount.create" Class="tf-form">
                    <div class="tf-form-grid">
                        <div class="tf-field">
                            <label class="tf-label" for="tf-sa-name">Display name</label>
                            <input id="tf-sa-name"
                                   name="name"
                                   class="tf-input"
                                   required
                                   maxlength="256"
                                   placeholder="Ticket Sync Worker"
                                   value="@CreateFormValue("name")" />
                        </div>
                        <div class="tf-field">
                            <label class="tf-label" for="tf-sa-client-id">Client ID (optional)</label>
                            <input id="tf-sa-client-id"
                                   name="clientId"
                                   class="tf-input tf-mono"
                                   maxlength="128"
                                   placeholder="Auto-generated (sa-...)"
                                   value="@CreateFormValue("clientId")" />
                        </div>
                        <div class="tf-field">
                            <label class="tf-label" for="tf-sa-scope">Scope</label>
                            <select id="tf-sa-scope" name="scope" class="tf-select">
                                @if (CanManageTenant)
                                {
                                    <option value="tenant" selected="@(CreateFormValue("scope", "workspace") == "tenant")">Tenant</option>
                                }
                                <option value="workspace" selected="@(CreateFormValue("scope", "workspace") == "workspace")">Whole workspace</option>
                                @foreach (var team in Teams)
                                {
                                    var optionValue = $"team:{team.Id.Value}";
                                    <option value="@optionValue" selected="@(CreateFormValue("scope", "workspace") == optionValue)">Team · @team.Name</option>
                                }
                                @foreach (var inbox in Inboxes)
                                {
                                    var optionValue = $"inbox:{inbox.Inbox.Id.Value}";
                                    <option value="@optionValue" selected="@(CreateFormValue("scope", "workspace") == optionValue)">Inbox · @inbox.Inbox.Name</option>
                                }
                            </select>
                        </div>
                        <div class="tf-field">
                            <label class="tf-label" for="tf-sa-role">Initial role (optional)</label>
                            <select id="tf-sa-role" name="role" class="tf-select">
                                <option value="">None — assign later</option>
                                @foreach (var entry in roleNames)
                                {
                                    <option value="@entry.Key" selected="@(CreateFormValue("role") == entry.Key)">@entry.Value</option>
                                }
                            </select>
                        </div>
                        <div class="tf-field tf-field--full">
                            <label class="tf-label" for="tf-sa-desc">Description (optional)</label>
                            <input id="tf-sa-desc"
                                   name="description"
                                   class="tf-input"
                                   maxlength="1024"
                                   placeholder="What automation or service authenticates with this account"
                                   value="@CreateFormValue("description")" />
                        </div>
                    </div>
                    <div class="tf-form-actions">
                        <BbButton Type="ButtonType.Submit">
                            <LucideIcon Name="bot" Size="14" />Create service account
                        </BbButton>
                    </div>
                </TfForm>
            </div>
        </div>
    }
</AccessGate>

@code {
    private readonly List<StoredServiceAccount> serviceAccounts = [];
    private readonly Dictionary<string, IReadOnlyList<StoredApiKey>> keysByClient = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<StoredAccessGrant>> grantsByClient = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> roleNames = new(StringComparer.Ordinal);
    private DateTimeOffset currentTime;

    private bool CanManageTenant => Session.Can(AccessPermissions.AccessManageTenant);

    private string? CreateFormValue(string field, string? fallback = null) =>
        string.Equals(Session.FormValue("_action", null), "access.serviceaccount.create", StringComparison.OrdinalIgnoreCase)
            ? Session.FormValue(field, fallback)
            : fallback;

    private string RoleLabel(RoleId roleId) => roleNames.GetValueOrDefault(roleId.Value, roleId.Value);

    private string ScopeLabel(GrantScope scope) => scope switch
    {
        TenantGrantScope => "Tenant",
        WorkspaceGrantScope => "Workspace",
        TeamGrantScope team => "Team · " + TeamName(team.Team),
        InboxGrantScope inbox => "Inbox · " + InboxName(inbox.Inbox),
    };

    private string ScopeOptionValue(GrantScope scope) => scope switch
    {
        TenantGrantScope => CanManageTenant ? "tenant" : "workspace",
        WorkspaceGrantScope => "workspace",
        TeamGrantScope team => $"team:{team.Team.Value}",
        InboxGrantScope inbox => $"inbox:{inbox.Inbox.Value}",
    };

    protected override async Task OnInitializedAsync()
    {
        currentTime = Service<TimeProvider>()?.GetUtcNow() ?? Now;
        if (!Session.Options.ManageApiKeysInUI)
            return;

        if (Service<IServiceAccountService>() is not { } service)
        {
            Denied = true;
            return;
        }

        var workspaceTask = LoadWorkspaceAsync();
        var accountsTask = service.ListServiceAccountsAsync(Actor, includeDisabled: true, Aborted).AsTask();
        var admin = Service<IAccessAdministrator>();
        var rolesTask = admin?.ListRolesAsync(Actor, Aborted);

        if (rolesTask is not null)
            await Task.WhenAll(workspaceTask, accountsTask, rolesTask);
        else
            await Task.WhenAll(workspaceTask, accountsTask);

        switch (accountsTask.Result)
        {
            case TicketValue<IReadOnlyList<StoredServiceAccount>> ok:
                serviceAccounts.AddRange(ok.Value.OrderByDescending(static sa => sa.CreatedAtUtc));
                break;
            case TicketFailure:
                Denied = true;
                return;
        }

        if (rolesTask?.Result is TicketValue<IReadOnlyList<AccessRoleListing>> roleListings)
            foreach (var listing in roleListings.Value)
                roleNames[listing.Role.Id.Value] = listing.Role.Name;
        else
            foreach (var builtIn in BuiltInRoles.All)
                roleNames[builtIn.Id.Value] = builtIn.Name;

        var keyTasks = serviceAccounts
            .Select(sa => (
                ClientId: sa.Account.ClientId.Value,
                Task: service.ListApiKeysAsync(Actor, sa.Account.ClientId, includeInactive: true, Aborted).AsTask()
            ))
            .ToArray();

        var targets = new List<GrantScope>(1 + Teams.Count + Inboxes.Count)
        {
            new WorkspaceGrantScope(Session.Scope.WorkspaceId),
        };
        foreach (var team in Teams)
            targets.Add(new TeamGrantScope(Session.Scope.WorkspaceId, team.Id));
        foreach (var inbox in Inboxes)
            targets.Add(new InboxGrantScope(Session.Scope.WorkspaceId, inbox.Inbox.Id));

        Task<TicketResult<IReadOnlyList<StoredAccessGrant>>>[] grantTasks = admin is null
            ? []
            : [.. targets.Select(target => admin.ListGrantsAsync(Actor, target, 200, null, Aborted))];

        var allTasks = new List<Task>(keyTasks.Length + grantTasks.Length);
        foreach (var entry in keyTasks)
            allTasks.Add(entry.Task);
        allTasks.AddRange(grantTasks);
        if (allTasks.Count > 0)
            await Task.WhenAll(allTasks);

        foreach (var entry in keyTasks)
            if (entry.Task.Result is TicketValue<IReadOnlyList<StoredApiKey>> keySuccess)
                keysByClient[entry.ClientId] = [.. keySuccess.Value.OrderByDescending(static k => k.CreatedAtUtc)];

        var seenGrantIds = new HashSet<GrantId>();
        var groupedGrants = new Dictionary<string, List<StoredAccessGrant>>(StringComparer.Ordinal);
        foreach (var task in grantTasks)
            if (task.Result is TicketValue<IReadOnlyList<StoredAccessGrant>> grantSuccess)
                foreach (var stored in grantSuccess.Value)
                    if (stored.Grant.Subject.TryGetValue(out ApiClientId client) && seenGrantIds.Add(stored.Grant.Id))
                    {
                        if (!groupedGrants.TryGetValue(client.Value, out var list))
                            groupedGrants[client.Value] = list = [];
                        list.Add(stored);
                    }

        if (CanManageTenant && serviceAccounts.Count > 0 && Service<IAccessGrantStore>() is { } grantStore)
        {
            var subjects = serviceAccounts
                .Select(static sa => (GrantSubject)sa.Account.ClientId)
                .Take(AccessLimits.MaximumSubjectsPerQuery)
                .ToArray();
            var subjectGrants = await grantStore.ListForSubjectsAsync(AccessPartition.From(Session.Scope), Session.Scope.WorkspaceId, subjects, Aborted);
            foreach (var stored in subjectGrants)
                if (stored.Grant.Scope is TenantGrantScope && stored.Grant.Subject.TryGetValue(out ApiClientId client) && seenGrantIds.Add(stored.Grant.Id))
                {
                    if (!groupedGrants.TryGetValue(client.Value, out var list))
                        groupedGrants[client.Value] = list = [];
                    list.Add(stored);
                }
        }

        foreach (var (clientId, list) in groupedGrants)
            grantsByClient[clientId] = list;
    }
}
